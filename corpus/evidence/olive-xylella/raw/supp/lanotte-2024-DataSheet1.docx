","Aline  Maria",[655],{"organizationName":656,"countryName":657,"cityName":19,"stateName":19,"zipCode":19},"University of São Paulo","Brazil",{"id":659,"firstName":660,"middleName":661,"lastName":662,"givenNames":663,"isCorresponding":372,"isProfilePublic":13,"userId":659,"email":-1,"affiliations":664},490239,"Paulo","Adriano","Zaini","Paulo  Adriano",[665],{"organizationName":666,"countryName":667,"cityName":19,"stateName":19,"zipCode":19},"Department of Plant Sciences, College of Agricultural and Environmental Sciences, University of California, Davis","United States",{"id":119,"slug":121,"name":120,"shortName":669,"electronicISSN":670,"field":671,"specialtyId":28,"journalSectionPaths":673},"Front. Plant Sci.","1664-462X",{"id":672,"domainId":397},66,[674],{"section":675},{"id":144,"name":145,"slug":146,"specialtyId":676},1745,{"views":678,"downloads":679,"citations":680},5250,1734,16,15,"Volume 15 - 2024",[],{"titleHtml":19,"fullTextHtml":19,"menuHtml":19},[686,691,696,699,704],{"name":687,"fileServerPackageEntryId":19,"fileServerId":688,"fileServerVersionNumber":397,"type":689},"EPUB.epub","1457831/epub",{"code":690,"name":690},"EPUB",{"name":692,"fileServerPackageEntryId":692,"fileServerId":693,"fileServerVersionNumber":397,"type":694},"fpls-15-1457831.pdf","1457831/pubmed-zip",{"code":695,"name":695},"PDF",{"name":692,"fileServerPackageEntryId":19,"fileServerId":697,"fileServerVersionNumber":397,"type":698},"1457831/publishers-proof/pdf",{"code":695,"name":695},{"name":700,"fileServerPackageEntryId":700,"fileServerId":693,"fileServerVersionNumber":397,"type":701},"fpls-15-1457831.xml",{"code":702,"name":703},"NLM_XML","XML",{"name":705,"fileServerPackageEntryId":19,"fileServerId":706,"fileServerVersionNumber":397,"type":707},"Provisional PDF.pdf","1457831/provisional-pdf",{"code":695,"name":695},"v4",{"title":710,"link":711,"meta":715,"script":866},"Frontiers | A survey in natural olive resources exposed to high inoculum pressure indicates the presence of tra