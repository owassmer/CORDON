staforte, Frantoio Oleario Giovanni Melcarne, Italy",{"hid":828,"name":789,"content":829},"citation_author_7","Specchia, Francesco ",{"hid":831,"name":793,"content":794},"citation_author_institution_7",{"hid":833,"name":789,"content":834},"citation_author_8","Altamura, Giuseppe ",{"hid":836,"name":793,"content":837},"citation_author_institution_8","Centro di Ricerca, Sperimentazione e Formazione in Agricoltura “Basile Caramia”, Italy",{"hid":839,"name":789,"content":840},"citation_author_9","Ligorio, Angela ",{"hid":842,"name":793,"content":794},"citation_author_institution_9",{"hid":844,"name":789,"content":845},"citation_author_10","Boscia, Donato ",{"hid":847,"name":793,"content":794},"citation_author_institution_10",{"hid":849,"name":789,"content":850},"citation_author_11","Surano, Antony ",{"hid":852,"name":793,"content":794},"citation_author_institution_11",{"hid":854,"name":789,"content":855},"citation_author_12","Saldarelli, Pasquale ",{"hid":857,"name":793,"content":794},"citation_author_institution_12",{"hid":859,"name":789,"content":860},"citation_author_13","Giampetruzzi, Annalisa ",{"hid":862,"name":793,"content":794},"citation_author_institution_13",{"hid":864,"name":864,"content":865},"dc.identifier","doi:10.3389/fpls.2024.1457831",[867,870,873,875],{"src":868,"body":13,"type":869,"async":13},"https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=es6","text/javascript",{"innerHTML":871,"type":872},"MathJax.Hub.Config({\"CommonHTML\":{linebreaks:{automatic:true,width:\"container\"}}});","text/x-mathjax-config",{"src":874,"body":13,"type":869,"async":13},"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-MML-AM_CHTML",{"src":876,"body":13,"type":869,"async":13},"https://crossmark-cdn.crossref.org/widget/v2.0/widget.js",{"journal":878,"doi":510,"articleType":525,"title":880,"authors":889,"onBehalfOf":19,"affiliations":937,"authorNotes":950,"publicationDate":985,"acceptedDate":986,"receivedDate":987,"correctedDate":19,"retractedDate":19,"volume":681,"elocationId":509,"permissions":988,"keywords":1008,"relatedArticles":1025,"abstractContent":1026,"bodyContent":1096,"appendixContent":6702,"statements":6703,"referenceLists":6910,"references":17793,"otherBackSections":27762,"figures":27763,"toc":30248,"correspondingAuthors":30264},{"title":120,"abbreviation":669,"issn":670,"publisherName":879},"Frontiers Media S.A.",[881,883,887],{"#text":882},"A survey in natural olive resources exposed to high inoculum pressure indicates the presence of traits of resistance to ",{"italic":884},[885],{"#text":886},"Xylella fastidiosa",{"#text":888}," in Leccino offspring",[890,894,897,901,904,907,910,914,917,921,924,927,930,934],{"surname":540,"givenNames":539,"suffix":19,"affiliationsIndexes":891,"isCorresponding":372,"equalContrib":13,"hierarchySymbol":892,"footnoteSymbol":19,"loopUrl":893,"onBehalfOf":19},[397],"\n            †\n          ","https://loop.frontiersin.org/people/2796596",{"surname":549,"givenNames":548,"suffix":19,"affiliationsIndexes":895,"isCorresponding":372,"equalContrib":13,"hierarchySymbol":892,"footnoteSymbol":19,"loopUrl":896,"onBehalfOf":19},[397],"https://loop.frontiersin.org/people/574662",{"surname":556,"givenNames":555,"suffix":19,"affiliationsIndexes":898,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":900,"onBehalfOf":19},[899],2,"https://loop.frontiersin.org/people/617382",{"surname":564,"givenNames":563,"suffix":19,"affiliationsIndexes":902,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":903,"onBehalfOf":19},[899],"https://loop.frontiersin.org/people/559218",{"surname":571,"givenNames":570,"suffix":19,"affiliationsIndexes":905,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":906,"onBehalfOf":19},[397],"https://loop.frontiersin.org/people/1254481",{"surname":578,"givenNames":577,"suffix":19,"affiliationsIndexes":908,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":909,"onBehalfOf":19},[899],"https://loop.frontiersin.org/people/2844678",{"surname":585,"givenNames":584,"suffix":19,"affiliationsIndexes":911,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":913,"onBehalfOf":19},[912],3,"https://loop.frontiersin.org/people/2844489",{"surname":593,"givenNames":592,"suffix":19,"affiliationsIndexes":915,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":916,"onBehalfOf":19},[397],"https://loop.frontiersin.org/people/2844441",{"surname":600,"givenNames":599,"suffix":19,"affiliationsIndexes":918,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":920,"onBehalfOf":19},[919],4,"https://loop.frontiersin.org/people/2844479",{"surname":608,"givenNames":607,"suffix":19,"affiliationsIndexes":922,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":923,"onBehalfOf":19},[397],"https://loop.frontiersin.org/people/2844669",{"surname":615,"givenNames":614,"suffix":19,"affiliationsIndexes":925,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":926,"onBehalfOf":19},[397],"https://loop.frontiersin.org/people/2844428",{"surname":622,"givenNames":621,"suffix":19,"affiliationsIndexes":928,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":929,"onBehalfOf":19},[397],"https://loop.frontiersin.org/people/1865595",{"surname":629,"givenNames":628,"suffix":19,"affiliationsIndexes":931,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":932,"footnoteSymbol":19,"loopUrl":933,"onBehalfOf":19},[397],"\n            *\n          ","https://loop.frontiersin.org/people/1496458",{"surname":637,"givenNames":636,"suffix":19,"affiliationsIndexes":935,"isCorresponding":372,"equalContrib":372,"hierarchySymbol":932,"footnoteSymbol":19,"loopUrl":936,"onBehalfOf":19},[397],"https://loop.frontiersin.org/people/2777596",[938,941,944,947],{"index":397,"baseText":19,"institution":544,"country":545,"address":939,"textContent":940},"Bari","Institute for Sustainable Plant Protection, National Research Council, Bari, Italy",{"index":899,"baseText":19,"institution":560,"country":545,"address":942,"textContent":943},"Perugia","Institute of Biosciences and Bioresources, National Research Council, Perugia, Italy",{"index":912,"baseText":19,"institution":589,"country":545,"address":945,"textContent":946},"Lecce","Forestaforte, Frantoio Oleario Giovanni Melcarne, Lecce, Italy",{"index":919,"baseText":19,"institution":604,"country":545,"address":948,"textContent":949},"Locorotondo","Centro di Ricerca, Sperimentazione e Formazione in Agricoltura “Basile Caramia”, Locorotondo, Italy",{"editedBy":951,"editedByContent":954,"reviewedBy":963,"reviewedByContent":968,"approvedBy":979,"approvedByContent":980,"correspondence":981,"equalContribution":982,"presentAddress":19,"other":984},[952],{"textContent":953},"Edited by: Giovanni Caruso, University of Pisa, Italy",[955,957,961],{"#text":956},"\n          ",{"p":958},[959],{"#text":960}," Giovanni Caruso, University of Pisa, Italy",{"#text":962},"\n        ",[964,966],{"textContent":965},"Reviewed by: Paulo Adriano Zaini, University of California, Davis, United States",{"textContent":967},"Aline Maria Da Silva, University of São Paulo, Brazil",[969,970,974,975,978],{"#text":956},{"p":971},[972],{"#text":973}," Paulo Adriano Zaini, University of California, Davis, United States",{"#text":956},{"p":976},[977],{"#text":967},{"#text":962},[],[],"\n          *Correspondence: Annalisa Giampetruzzi, YW5uYWxpc2EuZ2lhbXBldHJ1enppQGlwc3AuY25yLml0; Pasquale Saldarelli, cGFzcXVhbGUuc2FsZGFyZWxsaUBpcHNwLmNuci5pdA==\n        ",[983],"\n          †These authors have contributed equally to this work and share first authorship\n        ",[],"2024-09-30","2024-08-29","2024-07-01",{"copyrightStatement":989,"copyrightYear":990,"copyrightHolder":991,"licenseUrl":992,"licenseText":993},"Copyright © 2024 La Notte, Saponari, Mousavi, Mariotti, Abou Kubaa, Nikbakht, Melcarne, Specchia, Altamura, Ligorio, Boscia, Surano, Saldarelli and Giampetruzzi",2024,"La Notte, Saponari, Mousavi, Mariotti, Abou Kubaa, Nikbakht, Melcarne, Specchia, Altamura, Ligorio, Boscia, Surano, Saldarelli and Giampetruzzi","http://creativecommons.org/licenses/by/4.0/",[994,995,1007],{"#text":956},{"p":996},[997,999,1005],{"#text":998},"This is an open-access article distributed under the terms of the ",{"ext-link":1000,":@":1003},[1001],{"#text":1002},"Creative Commons Attribution License (CC BY)",{"@_ext-link-type":1004,"@_xlink:href":992},"uri",{"#text":1006},". The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms.",{"#text":962},[1009,1011,1014,1017,1019,1021,1023],[1010],{"#text":529},[1012],{"#text":1013},"olive",[1015],{"#text":1016},"resistance",[1018],{"#text":532},[1020],{"#text":533},[1022],{"#text":534},[1024],{"#text":535},[],[1027,1028,1046,1047,1060,1061,1080,1081,1094],{"#text":962},{"sec":1029},[1030,1031,1035,1036,1045],{"#text":956},{"title":1032},[1033],{"#text":1034},"Introduction",{"#text":956},{"p":1037},[1038,1040,1043],{"#text":1039},"The epidemic spread of the harmful bacterium ",{"italic":1041},[1042],{"#text":886},{"#text":1044}," causing the “olive quick decline syndrome”, decimating olive trees in southern Italy, in the region of Apulia, prompted investigations to search for olive genotypes harbouring traits of resistance.",{"#text":962},{"#text":962},{"sec":1048},[1049,1050,1054,1055,1059],{"#text":956},{"title":1051},[1052],{"#text":1053},"Methods",{"#text":956},{"p":1056},[1057],{"#text":1058},"A prospecting survey was carried out to identify, in the heavily infected area of Apulia, olive genotypes bearing resistance. Given the limited genetic diversity in the commercial olive groves with few cultivars widely cultivated, surveys targeted predominantly spontaneous olive genotypes in natural and uncultivated areas. Trees, selected for the absence of symptoms, were subjected to diagnostic tests and parentage analysis to disclose their genetic background. Transcriptomic analyses were also employed to decipher the molecular pathways in resistant genotypes. Artificial inoculations were carried out to confirm the resistant phenotypes of four open-pollinated seedlings of the cultivar Leccino.",{"#text":962},{"#text":962},{"sec":1062},[1063,1064,1068,1069,1079],{"#text":956},{"title":1065},[1066],{"#text":1067},"Results",{"#text":956},{"p":1070},[1071,1073,1077],{"#text":1072},"Among the 171 olive collected genotypes, 139 had unique simple sequence repeat (SSR) profiles, with the cultivars Leccino, Cellina di Nardò, and Ogliarola salentina being the most frequent candidate parents. Among the Leccino progeny (n. 61), 67% showed a highly resistant (HR), resistant (R), or tolerant (T) phenotype to infection by ",{"italic":1074},[1075],{"#text":1076},"X. fastidiosa",{"#text":1078},". The occurrence of such phenotypes among those deriving from Cellina di Nardò and Ogliarola salentina was 32% and 49%, respectively. Analyses of the transcriptomic profiles of three Leccino-bearing genotypes, naturally infected and not showing symptoms, unravelled that a total of 17,227, 13,031, and 4,513 genes were found altered in the expression, including genes involved in photosynthesis, cell wall, or primary and secondary metabolism.",{"#text":962},{"#text":962},{"sec":1082},[1083,1084,1088,1089,1093],{"#text":956},{"title":1085},[1086],{"#text":1087},"Discussion",{"#text":956},{"p":1090},[1091],{"#text":1092},"Indeed, transcriptomic analyses showed that one of these genotypes (S105) was more resilient to changes induced by the natural bacterial infection than the remaining two (S215 and S234). This study consolidates the evidence on the presence and heritage of resistance traits associated with the cv. Leccino. Moreover, valuable insights were gathered when analysing their transcriptomic profiles, i.e., genes involved in mechanisms of response to the bacterium, which can be used in functional genetic approaches to introduce resistance in susceptible cultivars and initiate strategies in olive-breeding programs through marker-assisted selection.",{"#text":962},{"#text":1095},"\n      ",[1097,1099,1672,1673,5317,5318,5873,5874,6700],{"#text":1098},"\n    ",{"sec":1100,":@":1669,"anchorId":1670},[1101,1102,1105,1106,1282,1283,1362,1363,1418,1419,1484,1485,1529,1530,1591,1592,1624,1625,1647,1648,1668],{"#text":1095},{"title":1103},[1104],{"#text":1034},{"#text":1095},{"p":1107},[1108,1110,1114,1116,1120,1122,1125,1127,1134,1136,1142,1144,1150,1151,1157,1158,1164,1165,1171,1172,1178,1179,1185,1186,1190,1192,1198,1199,1205,1206,1212,1213,1219,1220,1226,1227,1233,1234,1240,1241,1247,1248,1254,1255,1261,1262,1268,1269,1273,1274,1280],{"#text":1109},"The cultivated olive (",{"italic":1111},[1112],{"#text":1113},"Olea europaea",{"#text":1115},", subsp. ",{"italic":1117},[1118],{"#text":1119},"europaea",{"#text":1121},", var. ",{"italic":1123},[1124],{"#text":1119},{"#text":1126},") is one of the most important oil crops in the world, and 95% of total olive oil production is derived from the Mediterranean Basin (",{"xref":1128,":@":1131},[1129],{"#text":1130},"Mariotti et al., 2023",{"@_ref-type":1132,"@_rid":1133},"bibr","B55",{"#text":1135},"). Olive accounts for a very rich varietal heritage, which is represented by more than 1,200 named cultivars, over 3,000 minor cultivars, and an uncertain number of genotypes including pollinators, local ecotypes, and centennial trees (",{"xref":1137,":@":1140},[1138],{"#text":1139},"Hosseini-Mazinani et al., 2014",{"@_ref-type":1132,"@_rid":1141},"B33",{"#text":1143},"; ",{"xref":1145,":@":1148},[1146],{"#text":1147},"Diez et al., 2015",{"@_ref-type":1132,"@_rid":1149},"B21",{"#text":1143},{"xref":1152,":@":1155},[1153],{"#text":1154},"Mousavi et al., 2017",{"@_ref-type":1132,"@_rid":1156},"B62",{"#text":1143},{"xref":1159,":@":1162},[1160],{"#text":1161},"El Bakkali et al., 2019",{"@_ref-type":1132,"@_rid":1163},"B24",{"#text":1143},{"xref":1166,":@":1169},[1167],{"#text":1168},"Salazar-García et al., 2019",{"@_ref-type":1132,"@_rid":1170},"B73",{"#text":1143},{"xref":1173,":@":1176},[1174],{"#text":1175},"Sion et al., 2019",{"@_ref-type":1132,"@_rid":1177},"B77",{"#text":1143},{"xref":1180,":@":1183},[1181],{"#text":1182},"Valeri et al., 2022",{"@_ref-type":1132,"@_rid":1184},"B85",{"#text":1143},{"xref":1187,":@":1189},[1188],{"#text":1130},{"@_ref-type":1132,"@_rid":1133},{"#text":1191},"). Nowadays, the olive cultivation scenario is rapidly changing with the transition to modern and intensive cultivation schemes, entailing the plantation of a restricted number of cultivars suitable to such management systems, thus reducing the large biodiversity typical of the traditional olive industry. Locally grown varieties, empirically selected by farmers and naturally tested for their resilience to climate change, reduced water supply, energy, and chemical resources, represent a high-value source of variability for the sustainability of olive cultivation (",{"xref":1193,":@":1196},[1194],{"#text":1195},"Sakar et al., 2016",{"@_ref-type":1132,"@_rid":1197},"B72",{"#text":1143},{"xref":1200,":@":1203},[1201],{"#text":1202},"Sorkheh and Khaleghi, 2016",{"@_ref-type":1132,"@_rid":1204},"B78",{"#text":1143},{"xref":1207,":@":1210},[1208],{"#text":1209},"Cheng et al., 2017",{"@_ref-type":1132,"@_rid":1211},"B15",{"#text":1143},{"xref":1214,":@":1217},[1215],{"#text":1216},"Veloso et al., 2018",{"@_ref-type":1132,"@_rid":1218},"B86",{"#text":1143},{"xref":1221,":@":1224},[1222],{"#text":1223},"Hussain et al., 2019",{"@_ref-type":1132,"@_rid":1225},"B35",{"#text":1143},{"xref":1228,":@":1231},[1229],{"#text":1230},"Khadari et al., 2019",{"@_ref-type":1132,"@_rid":1232},"B43",{"#text":1143},{"xref":1235,":@":1238},[1236],{"#text":1237},"Mousavi et al., 2019",{"@_ref-type":1132,"@_rid":1239},"B64",{"#text":1143},{"xref":1242,":@":1245},[1243],{"#text":1244},"Atrouz et al., 2021",{"@_ref-type":1132,"@_rid":1246},"B4",{"#text":1143},{"xref":1249,":@":1252},[1250],{"#text":1251},"Islam et al., 2021",{"@_ref-type":1132,"@_rid":1253},"B37",{"#text":1143},{"xref":1256,":@":1259},[1257],{"#text":1258},"Omri et al., 2021",{"@_ref-type":1132,"@_rid":1260},"B66",{"#text":1143},{"xref":1263,":@":1266},[1264],{"#text":1265},"Topi et al., 2022",{"@_ref-type":1132,"@_rid":1267},"B81",{"#text":1143},{"xref":1270,":@":1272},[1271],{"#text":1182},{"@_ref-type":1132,"@_rid":1184},{"#text":1143},{"xref":1275,":@":1278},[1276],{"#text":1277},"Duran et al., 2022",{"@_ref-type":1132,"@_rid":1279},"B22",{"#text":1281},"). In traditional olive-growing areas, such as Apulia, much of the great genetic and phenotypic variability represented by the local germplasm is only partially explored, and often, some traditional varieties have been grafted with a few selected cultivars as happened in the Salento peninsula with the cultivars Ogliarola salentina and Cellina di Nardò. For this reason, it is important to conduct an in-depth investigation to adequately preserve and evaluate the current diversity of the olive tree and thereby initiate a renewal of olive growing against emerging diseases and climate change.",{"#text":1095},{"p":1284},[1285,1287,1290,1292,1296,1298,1302,1304,1310,1311,1317,1319,1325,1327,1331,1333,1339,1341,1344,1346,1352,1354,1360],{"#text":1286},"Currently, this important Mediterranean crop and landscape iconic tree is threatened by a severe disease, the olive quick decline syndrome (OQDS), caused by a strain of the bacterium ",{"italic":1288},[1289],{"#text":886},{"#text":1291}," subsp. ",{"italic":1293},[1294],{"#text":1295},"pauca",{"#text":1297}," (",{"italic":1299},[1300],{"#text":1301},"Xfp",{"#text":1303},"). This harmful plant pathogenic bacterium has been extensively investigated in the American continent where the pathogen originated and has evolved under different selective factors in biologically and genetically distinct populations (",{"xref":1305,":@":1308},[1306],{"#text":1307},"Castillo et al., 2020",{"@_ref-type":1132,"@_rid":1309},"B13",{"#text":1143},{"xref":1312,":@":1315},[1313],{"#text":1314},"Kahn and Almeida, 2022",{"@_ref-type":1132,"@_rid":1316},"B40",{"#text":1318},"). In the Americas, it is well known as the causal agent of detrimental diseases in crops and landscape trees, while it is only in the last decade that outbreaks emerged in the European and Mediterranean countries, with infections affecting olives, almond trees, and several essences typical of the Mediterranean flora (",{"xref":1320,":@":1323},[1321],{"#text":1322},"Landa et al., 2020",{"@_ref-type":1132,"@_rid":1324},"B50",{"#text":1326},"). Bacterial invasion in these new territories encountered favourable climatic conditions, a number of susceptible host species, and efficient insect vectors, such as the spittlebug ",{"italic":1328},[1329],{"#text":1330},"Philaenus spumarius",{"#text":1332}," L., contributing to the expansion of the initial outbreaks and favouring the persistence of the infections in endemic or epidemic forms. OQDS is the most emblematic example of the detrimental impact of this pathogen conquering the Old Continent (",{"xref":1334,":@":1337},[1335],{"#text":1336},"Saponari et al., 2019",{"@_ref-type":1132,"@_rid":1338},"B74",{"#text":1340},"). This deadly disease was described for the first time in the South of the Apulia region (southern Italy), where in 2013 an outbreak of ",{"italic":1342},[1343],{"#text":1301},{"#text":1345}," was recorded (",{"xref":1347,":@":1350},[1348],{"#text":1349},"Cariddi et al., 2014",{"@_ref-type":1132,"@_rid":1351},"B12",{"#text":1353},"). In the same area, the extensive cultivation of highly susceptible olive cultivars Cellina di Nardò and Ogliarola salentina caused the rapid evolution of the initial outbreak into one of the most severe epidemics in the history of plant diseases. Several million olive trees, including centennial plants, have been decimated with inestimable damage affecting different ecosystem services (",{"xref":1355,":@":1358},[1356],{"#text":1357},"Schneider et al., 2020",{"@_ref-type":1132,"@_rid":1359},"B75",{"#text":1361},").",{"#text":1095},{"p":1364},[1365,1367,1373,1375,1381,1383,1389,1391,1394,1396,1399,1400,1403,1405,1409,1411,1417],{"#text":1366},"Further investigations in other olive-growing areas in the world disclosed the occurrence of symptoms resembling those of OQDS reported in Apulia, Brazil (",{"xref":1368,":@":1371},[1369],{"#text":1370},"Coletta-Filho et al., 2016",{"@_ref-type":1132,"@_rid":1372},"B17",{"#text":1374},"), Argentina (",{"xref":1376,":@":1379},[1377],{"#text":1378},"Tolocka et al., 2017",{"@_ref-type":1132,"@_rid":1380},"B80",{"#text":1382},"), and Ibiza (",{"xref":1384,":@":1387},[1385],{"#text":1386},"Moralejo et al., 2020",{"@_ref-type":1132,"@_rid":1388},"B60",{"#text":1390},"). In all cases, different ",{"italic":1392},[1393],{"#text":1076},{"#text":1395}," (Xf) strains belonging to subsp. ",{"italic":1397},[1398],{"#text":1295},{"#text":1297},{"italic":1401},[1402],{"#text":1301},{"#text":1404},") have been detected and/or isolated from the diseased trees. Conversely, in California where only strains of the subsp. ",{"italic":1406},[1407],{"#text":1408},"multiplex",{"#text":1410}," have been reported infecting olives, only mild shoot dieback phenomena have been so far described (",{"xref":1412,":@":1415},[1413],{"#text":1414},"Krugner et al., 2014",{"@_ref-type":1132,"@_rid":1416},"B48",{"#text":1361},{"#text":1095},{"p":1420},[1421,1423,1426,1428,1434,1436,1439,1441,1445,1447,1451,1453,1457,1459,1463,1464,1468,1470,1476,1477,1483],{"#text":1422},"Nowadays, no curative solutions exist to rehabilitate ",{"italic":1424},[1425],{"#text":529},{"#text":1427},"-infected plants, and currently, the control relies on reducing vector population and removal of infected sources, whose success depends on the timely application of the interventions (",{"xref":1429,":@":1432},[1430],{"#text":1431},"Morelli et al., 2021",{"@_ref-type":1132,"@_rid":1433},"B61",{"#text":1435},"). In this context, as for many vascular plant diseases that are difficult to control with conventional means, genetic resistance represents the most promising long-term strategy for their sustainable management. With reference to the major ",{"italic":1437},[1438],{"#text":529},{"#text":1440},"-susceptible crops, such as grapevines, citrus, and olives, significant variations in the plant response and transmissibility of the bacterium are observed among genotypes and cultivars. Plants of susceptible cultivars generally harbour high bacterial populations in all tissues and show severe symptoms, while those exhibiting resistance maintain low bacterial loads, erratic distribution of the bacterium in the infected tissues, and limited expression of symptoms. In grapes, all domesticated grapevines (",{"italic":1442},[1443],{"#text":1444},"Vitis vinifera",{"#text":1446}," ssp. ",{"italic":1448},[1449],{"#text":1450},"vinifera",{"#text":1452},") are susceptible to Xf, whose infections cause the notorious Pierce’s disease (PD), while some wild relatives, mainly ",{"italic":1454},[1455],{"#text":1456},"Vitis arizonica",{"#text":1458},", exhibit strong resistance to PD. Resistance phenomenon in this wild species has been associated with the segregating ",{"italic":1460},[1461],{"#text":1462},"Pierce’s disease resistance 1",{"#text":1297},{"italic":1465},[1466],{"#text":1467},"PdR1",{"#text":1469},") locus (",{"xref":1471,":@":1474},[1472],{"#text":1473},"Krivanek et al., 2006",{"@_ref-type":1132,"@_rid":1475},"B47",{"#text":1143},{"xref":1478,":@":1481},[1479],{"#text":1480},"Riaz et al., 2008",{"@_ref-type":1132,"@_rid":1482},"B70",{"#text":1361},{"#text":1095},{"p":1486},[1487,1489,1492,1494,1498,1500,1506,1508,1512,1514,1520,1522,1528],{"#text":1488},"Similarly, in citrus, the existence of genetic traits of resistance to ",{"italic":1490},[1491],{"#text":1301},{"#text":1493}," has been reported; i.e., several mandarins (",{"italic":1495},[1496],{"#text":1497},"Citrus reticulata",{"#text":1499},") are considered resistant (",{"xref":1501,":@":1504},[1502],{"#text":1503},"Niza et al., 2015",{"@_ref-type":1132,"@_rid":1505},"B65",{"#text":1507},"), while the majority of the commercially cultivated sweet orange (",{"italic":1509},[1510],{"#text":1511},"Citrus sinensis",{"#text":1513}," L. Osb.) varieties are susceptible (",{"xref":1515,":@":1518},[1516],{"#text":1517},"Laranjeira et al., 1998",{"@_ref-type":1132,"@_rid":1519},"B51",{"#text":1521},"). Citrus hybrids obtained between these two groups of species demonstrated the segregation of the resistance genetic traits in the progeny (",{"xref":1523,":@":1526},[1524],{"#text":1525},"Mauricio et al., 2019",{"@_ref-type":1132,"@_rid":1527},"B58",{"#text":1361},{"#text":1095},{"p":1531},[1532,1534,1537,1539,1545,1547,1553,1554,1560,1562,1568,1570,1576,1577,1583,1584,1590],{"#text":1533},"In olives, resistance phenomenon to ",{"italic":1535},[1536],{"#text":1301},{"#text":1538}," has been discovered in two cultivars, Leccino and FS-17, whose infected trees show limited occurrences of desiccation phenomenon on the canopies, together with low populations and localized presence of the bacterium in the canopies of the trees. Recent studies, mainly based on physiological and anatomical observations and metagenomic approaches, suggest a quite complex network of host–pathogen interactions and factors involved. For example, resistant trees of the cv. Leccino appear to be able to isolate the bacterium in xylem vessels (",{"xref":1540,":@":1543},[1541],{"#text":1542},"Walker et al., 2023",{"@_ref-type":1132,"@_rid":1544},"B88",{"#text":1546},"), respond to and better manage the drought stress caused by the bacterium (",{"xref":1548,":@":1551},[1549],{"#text":1550},"de Pascali et al., 2019",{"@_ref-type":1132,"@_rid":1552},"B19",{"#text":1143},{"xref":1555,":@":1558},[1556],{"#text":1557},"Surano et al., 2022",{"@_ref-type":1132,"@_rid":1559},"B79",{"#text":1561},"), efficiently resist to the activity of the bacterial cell wall-degrading enzymes (",{"xref":1563,":@":1566},[1564],{"#text":1565},"Montilon et al., 2022",{"@_ref-type":1132,"@_rid":1567},"B59",{"#text":1569},"), and sustain a “resilient” microbiome (",{"xref":1571,":@":1574},[1572],{"#text":1573},"Baptista et al., 2019",{"@_ref-type":1132,"@_rid":1575},"B6",{"#text":1143},{"xref":1578,":@":1581},[1579],{"#text":1580},"Giampetruzzi et al., 2020",{"@_ref-type":1132,"@_rid":1582},"B27",{"#text":1143},{"xref":1585,":@":1588},[1586],{"#text":1587},"Vergine et al., 2020",{"@_ref-type":1132,"@_rid":1589},"B87",{"#text":1361},{"#text":1095},{"p":1593},[1594,1596,1599,1601,1607,1609,1615,1617,1623],{"#text":1595},"It should be remarked that despite the relevant research investments over the last century, the genomic architecture of resistance to ",{"italic":1597},[1598],{"#text":529},{"#text":1600}," has been limitedly investigated, and its genetic basis remains largely unclear. Even so, the most recent research outcomes suggest the existence of common defence responses across the main crop species. For example, investigations on the resistant olive cv. Leccino indicates that proteins belonging to the leucine-rich receptor kinase family are involved in the plant response to infections (",{"xref":1602,":@":1605},[1603],{"#text":1604},"Giampetruzzi et al., 2016",{"@_ref-type":1132,"@_rid":1606},"B28",{"#text":1608},"), a research route that is supported by the existence of similar evidence in grapevine (",{"xref":1610,":@":1613},[1611],{"#text":1612},"Agüero et al., 2022",{"@_ref-type":1132,"@_rid":1614},"B1",{"#text":1616},") and citrus (",{"xref":1618,":@":1621},[1619],{"#text":1620},"Rodrigues et al., 2013",{"@_ref-type":1132,"@_rid":1622},"B71",{"#text":1361},{"#text":1095},{"p":1626},[1627,1629,1632,1634,1640,1642,1645],{"#text":1628},"In olives, despite the germplasm richness in terms of genetic diversity, preliminary results of large-scale screening for ",{"italic":1630},[1631],{"#text":1301},{"#text":1633}," resistance indicated that none of the tested olive cultivars/selections showed a level of resistance similar to or higher than that of Leccino and FS-17 (",{"xref":1635,":@":1638},[1636],{"#text":1637},"Boscia et al., 2017",{"@_ref-type":1132,"@_rid":1639},"B9",{"#text":1641},"). In contrast, in olives, the availability of large, crossbred populations of genotypes is very limited due to scarce investments in breeding programs, whose main challenge is the long duration of the preselection and selection phases. However, the emergence of OQDS makes it no longer possible to devote research efforts to the development of new resistant genotypes by classical or biotechnological approaches. In the meantime, to take advantage of the natural selection process of resistant genotypes in the area affected by the ",{"italic":1643},[1644],{"#text":1301},{"#text":1646}," epidemic, we conducted an extensive survey in the demarcated infected area of Apulia where the cultivated and natural olive germplasms are under high pressure of inoculum for many years.",{"#text":1095},{"p":1649},[1650,1652,1656,1658,1661,1663,1666],{"#text":1651},"Surveys carried out over the past 6 years allowed us to identify 171 ",{"italic":1653},[1654],{"#text":1655},"spontaneous",{"#text":1657}," olive genotypes, based on the absence of manifest ",{"italic":1659},[1660],{"#text":1301},{"#text":1662}," symptoms, which were tested for several years to monitor the occurrence of the infections, the bacterial population size, and the development of symptoms. Over time, several genotypes became symptomatic and were discarded from further studies and assessments, while many of them remained symptomless or with mild desiccation phenomenon. Parentage analysis was carried out to disclose the genealogy of these genotypes and assess which cultivars contributed to the resistant phenotypes. On a few selected genotypes displaying highly promising resistant phenotypes, more in-depth analyses were carried out, i.e., transcriptomic profiling and artificial bacterial inoculations to reproduce under controlled conditions artificial infections and monitor the genotype response to ",{"italic":1664},[1665],{"#text":1301},{"#text":1667},".",{"#text":1098},{"@_id":1670,"@_sec-type":1671},"s1","intro",{"#text":1098},{"sec":1674,":@":5314,"anchorId":5315},[1675,1676,1679,1680,1765,1766,3693,3694,3787,3788,3844,3845,4770,4771,4837,4838,4967,4968,5141,5142,5313],{"#text":1095},{"title":1677},[1678],{"#text":1067},{"#text":1095},{"sec":1681,":@":1763},[1682,1683,1687,1688,1717,1718,1749,1750,1762],{"#text":962},{"title":1684},[1685],{"#text":1686},"Phenotype assessment on the selected germplasm",{"#text":962},{"p":1689},[1690,1692,1695,1697,1706,1708,1715],{"#text":1691},"In 2022, a final assessment was performed on all selected spontaneous trees by scoring the presence/absence of symptoms and by testing multiple sub-samples from each tree. Genotypes were categorized as highly susceptible (HS), susceptible (S), tolerant (T), resistant (R), and highly resistant (HR) based on symptoms severity, estimation of the bacterial population in the tree, and frequency of ",{"italic":1693},[1694],{"#text":1301},{"#text":1696},"-positive shoots in the canopy. According to the results of the genetic assessment, these 171 genotypes have been divided into two groups after genetic analysis—open-pollinated seedlings (n. 139) (",{"xref":1698,":@":1703},[1699],{"bold":1700},[1701],{"#text":1702},"Supplementary Figure S1",{"@_ref-type":1704,"@_rid":1705},"supplementary-material","SM1",{"#text":1707},") and cultivars (n. 32) (",{"xref":1709,":@":1714},[1710],{"bold":1711},[1712],{"#text":1713},"Supplementary Table S1",{"@_ref-type":1704,"@_rid":1705},{"#text":1716},")—with the latter including genotypes visually misidentified as putative seedlings.",{"#text":962},{"p":1719},[1720,1722,1729,1731,1738,1740,1747],{"#text":1721},"The selected genotypes were all asymptomatic and with low or undetectable levels of the bacterium when firstly identified in the area (",{"xref":1723,":@":1728},[1724],{"bold":1725},[1726],{"#text":1727},"Supplementary Figures S1A, B",{"@_ref-type":1704,"@_rid":1705},{"#text":1730},"). Nonetheless, almost half of them during the period of observation (2016–2022, ",{"xref":1732,":@":1737},[1733],{"bold":1734},[1735],{"#text":1736},"Supplementary Figure S1B",{"@_ref-type":1704,"@_rid":1705},{"#text":1739},") became symptomatic and highly infected, as shown by the number of genotypes categorized as HS or S (",{"xref":1741,":@":1746},[1742],{"bold":1743},[1744],{"#text":1745},"Supplementary Figure S1E",{"@_ref-type":1704,"@_rid":1705},{"#text":1748},"). However, it should be considered that concomitant biotic/abiotic stresses in some cases may have exacerbated the desiccation phenomenon.",{"#text":962},{"p":1751},[1752,1754,1760],{"#text":1753},"In contrast, the absence of symptoms and the low infection rates in the remaining genotypes not necessary can be associated unambiguously with the host response, given the variable epidemiological conditions occurring in the different locations (i.e., adverse conditions for the vectors) and the observations limited to single unique individual trees without biological replicates. This shortcoming emerges also from the phenotypic assignment for the 32 genotypes that afterwards have been assigned to known cultivars (",{"xref":1755,":@":1759},[1756],{"bold":1757},[1758],{"#text":1713},{"@_ref-type":1704,"@_rid":1705},{"#text":1761},"). In this batch of trees, while data are consistent for the resistant cultivar Leccino and the susceptible cultivar Cellina di Nardò and Ogliarola salentina, there are examples like Arbequina and Simone whose trees have been categorized as resistant, but recent data from commercial groves and experimental plots indicate that they are among the most susceptible (Saponari, personal communication).",{"#text":1095},{"@_id":1764},"s2_1",{"#text":1095},{"sec":1767,":@":3691},[1768,1769,1773,1774,1802,1803,1829,1830,1874,1875,3577,3578,3599,3600,3654,3655,3690],{"#text":962},{"title":1770},[1771],{"#text":1772},"Genetic diversity and differentiation analysis",{"#text":962},{"p":1775},[1776,1778,1787,1789,1792,1794,1800],{"#text":1777},"Among the 171 identified spontaneous genotypes, 139 had unique simple sequence repeat (SSR) profiles, while 32 of them were known olive cultivars. To analyse the genetic diversity of these spontaneous olive trees, 25 mostly diffused cultivars in the Apulia region were included in the study for SSR profile comparison. A neighbour joining (NJ) statistical method, selected to draw a tree based on a genetic distance matrix, showed that spontaneous genotypes separated into three distinct clusters (",{"xref":1779,":@":1784},[1780],{"bold":1781},[1782],{"#text":1783},"Figure 1",{"@_ref-type":1785,"@_rid":1786},"fig","f1",{"#text":1788},"). The first cluster (highlighted by all branches in dark grey colour) was divided into two sub-clusters, of which one was represented by highly susceptible (nine, red colour) together with a mix composed of tolerant (12, brown colour), resistant (22, light green), and susceptible (35, fuchsia) genotypes with the presence of some known cultivars such as Ogliarola salentina, which is considered nowadays the most susceptible cultivar, along with Canino, Ottobratica, and Coratina. The other sub-cluster instead mostly includes tolerant (five) and susceptible (six) genotypes together with the cv. Ascolana tenera. The second cluster (grey branches) includes genotypes with different responses to ",{"italic":1790},[1791],{"#text":1301},{"#text":1793}," and was represented by the presence of the highly susceptible cv. Cellina di Nardò. This cluster groups spontaneous olive trees both highly susceptible (six) and highly resistant (three); a considerable number of resistant (16) and tolerant (5) genotypes are also present. The third cluster (light grey) contains approximately the same number of susceptible (16) and resistant (19) genotypes, including the cultivar Leccino (",{"xref":1795,":@":1799},[1796],{"bold":1797},[1798],{"#text":1783},{"@_ref-type":1785,"@_rid":1786},{"#text":1801},"). These findings showed high genetic diversity and admixture in terms of susceptibility among spontaneous genotypes rescued in a limited area.",{"#text":962},{"fig":1804,":@":1827},[1805,1806,1809,1810,1819,1820,1826],{"#text":956},{"label":1807},[1808],{"#text":1783},{"#text":956},{"caption":1811},[1812,1814,1818],{"#text":1813},"\n            ",{"p":1815},[1816],{"#text":1817},"Neighbour-joining (NJ) tree based on genetic distance matrix of the 171 selected genotypes. Three distinct clusters were highlighted: the first cluster (dark grey branches) was divided into two sub-clusters; the second cluster (grey branches) with the presence of the highly susceptible cv. Cellina di Nardò; and the third (light grey branches), which contains cultivar Leccino. More details in the text.",{"#text":956},{"#text":956},{"graphic":1821,":@":1822},[],{"@_mimetype":390,"@_mime-subtype":1823,"@_xmlns:xlink":1824,"@_xlink:href":1825},"tiff","http://www.w3.org/1999/xlink","fpls-15-1457831-g001.tif",{"#text":962},{"@_id":1786,"@_position":1828},"float",{"#text":962},{"p":1831},[1832,1834,1841,1843,1849,1851,1854,1856,1865,1867,1873],{"#text":1833},"The 10 loci used in this study showed a high degree of polymorphism among the 171 unique genotypes and revealed a total of 146 alleles. Allele numbers for all samples ranged from a minimum of five to a maximum of 21, respectively, at EMO90 and DCA9 loci (",{"xref":1835,":@":1840},[1836],{"bold":1837},[1838],{"#text":1839},"Supplementary Table S2",{"@_ref-type":1704,"@_rid":1705},{"#text":1842},"). The number of effective alleles ranged from 2.72 to 6.82, and Shannon’s information index ranged from 1.31 to 2.22. The mean of Ho was the same as that of He (0.80). Fixation values (F) were negative on average, excluding GAPU103A and UDO-043. A negligible or moderate number of null alleles were observed except for the latter two loci, for which the number of homozygous alleles was high. The polymorphism information content (PIC) values were higher than 0.5 at all loci, with an average value of 0.74 and maximum discrimination power for DCA9 (0.83) and UDO-043 (0.84) (",{"xref":1844,":@":1848},[1845],{"bold":1846},[1847],{"#text":1839},{"@_ref-type":1704,"@_rid":1705},{"#text":1850},"). To better study the allele frequency and its possible correlation with ",{"italic":1852},[1853],{"#text":1301},{"#text":1855}," resistance, the 171 genotypes were divided into two populations (POP): susceptible (including HS and S) and resistant (containing HR, R, and T) genotypes (",{"xref":1857,":@":1862},[1858],{"bold":1859},[1860],{"#text":1861},"Table 1",{"@_ref-type":1863,"@_rid":1864},"table","T1",{"#text":1866},"). The fixation index (F) had the highest value in GAPU103A of POP susceptible (0.19), unravelling the high inbreeding level in this population. A similar result was observed also for the UDO-043 locus, whose F value (0.10) was higher in susceptible POP. In addition, the frequency of private alleles had the maximum level in this POP (0.038) (",{"xref":1868,":@":1872},[1869],{"bold":1870},[1871],{"#text":1861},{"@_ref-type":1863,"@_rid":1864},{"#text":1361},{"#text":962},{"table-wrap":1876,":@":3576},[1877,1878,1881,1882,1890,1891,3562,3563,3575],{"#text":956},{"label":1879},[1880],{"#text":1861},{"#text":956},{"caption":1883},[1884,1885,1889],{"#text":1813},{"p":1886},[1887],{"#text":1888},"Indices of genetic diversity of resistant and susceptible populations (POPs).",{"#text":956},{"#text":956},{"table":1892,":@":3560},[1893,1894,1978,1979,3559],{"#text":1813},{"thead":1895},[1896,1898,1977],{"#text":1897},"\n              ",{"tr":1899},[1900,1902,1909,1910,1916,1917,1922,1923,1928,1929,1934,1935,1940,1941,1946,1947,1952,1953,1958,1959,1964,1965,1970,1971,1976],{"#text":1901},"\n                ",{"th":1903,":@":1906},[1904],{"#text":1905},"Locus",{"@_valign":1907,"@_align":1908},"top","left",{"#text":1901},{"th":1911,":@":1914},[1912],{"#text":1913},"Population",{"@_valign":1907,"@_align":1915},"center",{"#text":1901},{"th":1918,":@":1921},[1919],{"#text":1920},"N",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1924,":@":1927},[1925],{"#text":1926},"Na",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1930,":@":1933},[1931],{"#text":1932},"Ne",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1936,":@":1939},[1937],{"#text":1938},"I",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1942,":@":1945},[1943],{"#text":1944},"Ho",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1948,":@":1951},[1949],{"#text":1950},"He",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1954,":@":1957},[1955],{"#text":1956},"UHE",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1960,":@":1963},[1961],{"#text":1962},"F",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1966,":@":1969},[1967],{"#text":1968},"PA",{"@_valign":1907,"@_align":1915},{"#text":1901},{"th":1972,":@":1975},[1973],{"#text":1974},"PAf",{"@_valign":1907,"@_align":1915},{"#text":1897},{"#text":1813},{"#text":1813},{"tbody":1980},[1981,1982,2057,2058,2130,2131,2203,2204,2275,2276,2348,2349,2423,2424,2494,2495,2566,2567,2637,2638,2708,2709,2781,2782,2851,2852,2922,2923,2991,2992,3062,3063,3132,3133,3203,3204,3283,3284,3351,3352,3428,3429,3499,3500,3558],{"#text":1897},{"tr":1983},[1984,1985,1995,1996,2001,2002,2007,2008,2013,2014,2019,2020,20